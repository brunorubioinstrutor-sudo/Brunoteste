# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" para repositórios públicos ou para o front-end.

# Token de acesso da sua conta RD Station CRM
# (RD Station CRM > Configurações > Tokens de API)
RD_CRM_TOKEN=coloque_aqui_o_token_do_rd_station_crm

# Caminho dentro de cada "deal" retornado pela RD Station onde está o nome
# do responsável (owner). Ajuste conforme o retorno real da sua conta.
# Exemplos comuns: user.name | owner.name | deal_owner.name
RD_OWNER_FIELD_PATH=user.name

# Porta em que o servidor vai rodar
PORT=3001

# Domínio(s) autorizado(s) a chamar este backend (CORS).
# Use "*" apenas para testes locais.
ALLOWED_ORIGIN=*
